# --- Site password gate (optional) ---
# When set, visitors must enter this password once (stored in an httpOnly cookie).
# Leave unset in local dev to skip the gate. Set on Vercel for production.
SITE_PASSWORD=
# Optional: separate secret for signing the auth cookie (recommended in production).
# If omitted, SITE_PASSWORD is used as the signing key.
# SITE_AUTH_SECRET=generate-a-long-random-string

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Optional: override the model. Defaults to gpt-4o-mini (fast & cheap, ~$0.0002/question).
# OPENAI_MODEL=gpt-4o-mini

# --- Supabase ---
# Project Settings → API (NOT the browser dashboard URL).
# SUPABASE_URL must end with .supabase.co — e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Use the ANON key (the schema enables permissive RLS so anon access works).
# This is the safe option — anon keys can be exposed publicly.
SUPABASE_ANON_KEY=eyJhbGci...

# OR, if you prefer to bypass RLS, use the service_role key instead.
# If both are set, SERVICE_ROLE takes precedence.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
