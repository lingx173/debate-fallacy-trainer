# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Optional: override the model. Defaults to gpt-4o-mini (fast & cheap, ~$0.0002/question).
# OPENAI_MODEL=gpt-4o-mini

# --- Supabase ---
# Project Settings → API (NOT the browser dashboard URL).
# SUPABASE_URL must end with .supabase.co — e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Use the ANON key (the schema enables permissive RLS so anon access works).
# This is the safe option — anon keys can be exposed publicly.
SUPABASE_ANON_KEY=eyJhbGci...

# OR, if you prefer to bypass RLS, use the service_role key instead.
# If both are set, SERVICE_ROLE takes precedence.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
